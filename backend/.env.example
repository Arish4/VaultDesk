# Copy this file to .env and adjust. Without .env the app uses SQLite and runs Celery tasks inline.

# Local PostgreSQL (after installing it and creating the database):
# DATABASE_URL=postgres://vaultdesk:vaultdesk@localhost:5432/vaultdesk

# Local Redis (only if you run it; enables the real Celery worker + Redis cache):
# REDIS_URL=redis://localhost:6379/0

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-for-real-use
